{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SceneJump 场景跳转关系表",
    "description": "SceneJump custom action 使用的场景跳转关系表：scenes 定义场景（场景名即 pipeline 节点名），edges 定义场景间的一步跳转关系。路径规划用 Dijkstra 取总成本最小路径。",
    "type": "object",
    "required": [
        "scenes",
        "edges"
    ],
    "properties": {
        "$doc": {
            "type": "string",
            "description": "数据文件的说明文字（可选）"
        },
        "$schema": {
            "type": "string",
            "description": "本文件的 JSON Schema 引用（可选）"
        },
        "scenes": {
            "type": "object",
            "description": "场景定义表：key 为场景名，value 为场景属性。更具体的场景应放在前面，以便优先识别；无 detect 的场景仅作 parent 使用。",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "description": "场景名应形如 Status_In_MainMenu"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "desc"
                ],
                "properties": {
                    "desc": {
                        "type": "string",
                        "description": "场景的中文描述，用于日志可读性"
                    },
                    "detect": {
                        "description": "用于识别该场景的识别条件；可选。缺省表示该场景仅作 parent 使用（抽象分组，不直接识别）。\n\n写法一：pipeline 节点名字符串，命中即视为处于该场景。\n写法二：组合识别对象，{\"type\":\"And\",\"all_of\":[节点名,...]}（全部命中）或 {\"type\":\"Or\",\"any_of\":[节点名,...]}（任一命中），语义与 pipeline 的 And/Or 一致。\n组合写法用于区分共用同一父界面节点的多个子场景，例如 {\"type\":\"And\",\"all_of\":[\"UI_Shop_VipShop\",\"UI_Shop_OCRSelected_1\"]}。列表元素只支持节点名字符串。",
                        "oneOf": [
                            {
                                "type": "string",
                                "minLength": 1,
                                "description": "pipeline 节点名，命中即视为处于该场景"
                            },
                            {
                                "type": "object",
                                "required": [
                                    "type",
                                    "all_of"
                                ],
                                "properties": {
                                    "type": {
                                        "const": "And",
                                        "description": "逻辑与：所有子识别都命中才算处于该场景"
                                    },
                                    "all_of": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "description": "子识别节点名列表；须全部命中"
                                    }
                                },
                                "additionalProperties": false
                            },
                            {
                                "type": "object",
                                "required": [
                                    "type",
                                    "any_of"
                                ],
                                "properties": {
                                    "type": {
                                        "const": "Or",
                                        "description": "逻辑或：任一子识别命中即算处于该场景"
                                    },
                                    "any_of": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "description": "子识别节点名列表；命中任一即可"
                                    }
                                },
                                "additionalProperties": false
                            }
                        ]
                    },
                    "parent": {
                        "type": "string",
                        "description": "父场景名。处于该场景时，也视为满足父场景（如 Status_In_Combat_MainStory 的 parent 为 Status_In_Combat）"
                    }
                },
                "additionalProperties": false
            }
        },
        "edges": {
            "type": "array",
            "description": "跳转关系（有向边）列表：from=当前场景, to=目标场景, cost=成本, jump=一步跳转要执行的节点, via=中间场景",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "from",
                    "to"
                ],
                "properties": {
                    "from": {
                        "type": "string",
                        "description": "当前场景名，须在 scenes 中定义"
                    },
                    "to": {
                        "description": "目标场景名，或场景名列表（操作后有概率进入其中任意一个）",
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    },
                    "cost": {
                        "type": "number",
                        "minimum": 0,
                        "description": "该一步跳转的成本（缺省 1，数值越小越优先）"
                    },
                    "jump": {
                        "description": "一步跳转要执行的 pipeline 节点名，或节点名数组（按序执行）。留空表示无需操作（如仅等待加载结束）",
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    },
                    "via": {
                        "type": "array",
                        "description": "跳转过程中会短暂经过、且无需额外操作的中间场景名列表（如 Status_Loading_Screen）",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
