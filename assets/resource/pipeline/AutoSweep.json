{
    "AutoSweepMain": {
        "desc": "自动刷本入口",
        "next": [
            "AutoSweepStage",
            "[JumpBack]AutoSweep_Do:JumpToField"
        ],
        "focus": {
            "Node.Recognition.Starting": {
                "content": "正在规划路线……",
                "display": [
                    "log"
                ]
            }
        }
    },
    "AutoSweep_Do:JumpToField": {
        "desc": "任意界面跳转到出击-资源收集区域（SceneJump 通用跳转，target 由任务选项注入）",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SceneJump",
                "custom_action_param": {
                    "target": "Combat_MaterialQuests_2"
                }
            }
        }
    },
    "AutoSweepStage": {
        "recognition": "And",
        "all_of": [
            "UI_Combat_MaterialQuests_Field_2"
        ],
        "next": [
            "AutoSweep_Stage",
            "AutoSweepFinish"
        ]
    },
    "AutoSweep_Stage": {
        "desc": "选关",
        "next": [
            "[JumpBack]SceneDo_Swipe_Stage_Swipe2begin",
            "AutoSweep_Stage_Click",
            "[JumpBack]SceneDo_Swipe_Stage_Swipe2next"
        ]
    },
    "AutoSweep_Stage_Click": {
        "desc": "选关-点击",
        "recognition": "And",
        "all_of": [
            "UI_Combat_Stage_2-2"
        ],
        "action": "Click",
        "next": [
            "AutoSweepManager"
        ]
    },
    "AutoSweepManager": {
        "desc": "扫荡管理器（custom 控制扫荡循环）",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AutoSweepManager",
                "custom_action_param": {
                    "batch_size": "auto"
                }
            }
        },
        "next": [
            "AutoSweepFinish"
        ]
    },
    "AutoSweep_Check_unlock": {
        "desc": "确保已解锁自动战斗",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "UI/Combat/StageDetails/Sweep_lock.png" //[715,440,395,135]
                ],
                "roi": [
                    695,
                    410,
                    435,
                    175
                ]
            }
        }
    },
    "AutoSweepFailed_lock": {
        "focus": {
            "Node.Recognition.Starting": {
                "content": "任务失败！对应关卡未解锁自动战斗。",
                "display": [
                    "log",
                    "notification"
                ]
            }
        }
    },
    "AutoSweep_Check_Stamina": {
        "desc": "确保体力足够",
