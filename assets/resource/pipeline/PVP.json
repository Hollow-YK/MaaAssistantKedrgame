{
    "PVPMain": {
        "desc": "玩家对战-入口：确保在主界面后进入对战",
        "next": [
            "PVP_Click:Exercise",
            "[JumpBack]PVP_Do:JumpToMain"
        ]
    },
    "PVP_Do:JumpToMain": {
        "desc": "任意界面跳转回主界面（SceneJump 通用跳转）",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SceneJump",
                "custom_action_param": {
                    "target": "MainMenu"
                }
            }
        }
    },
    "PVP_Click:Exercise": {
        "desc": "点击主界面-对战入口",
        "recognition": "And",
        "all_of": [
            "UI_MainMenu_exercise"
        ],
        "action": "Click",
        "post_delay": 2000,
        "next": [
            "PVP_Click:SeasonReset_Continue",
            "PVP_Verify:BattleInterface"
        ]
    },
    "PVP_Click:SeasonReset_Continue": {
        "desc": "赛季重置：识别「点击任意处继续」提示并点击（并列候选；未命中时由上游 PVP_Click:Exercise 的 next 列表继续尝试确认对战界面；timeout 仅作用于本节点作为父节点评估自身 next 链的轮询预算，非候选未命中回落时间）",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "点击任意处继续"
                ],
                "roi": [
                    552,
                    640,
                    176,
                    31
                ],
                "only_rec": true,
                "threshold": 0.8
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "next": [
            "PVP_Check:SeasonReset_EnterFormation",
            "PVP_Click:SeasonReset_Continue"
        ]
    },
