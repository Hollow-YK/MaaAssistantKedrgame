    "PVP_Check:ChallengeLimit": {
        "desc": "检测今日挑战次数是否用完（并列候选，命中则返回主页结束任务）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "PVP/challenge_limit.png"
                ],
                "roi": [
                    311,
                    85,
                    71,
                    77
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PVP_Log",
                "custom_action_param": {
                    "content": "[PVP] 今日挑战次数已用完"
                }
            }
        },
        "next": [
            "PVP_Click:MainMenu"
        ]
    },
    "PVP_Click:StartBattle": {
        "desc": "点击开始战斗（复用 UI/Combat/Start2 编队界面按钮模板）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "UI/Combat/Start2.png"
                ],
                "roi": [
                    940,
                    620,
                    300,
                    90
                ],
                "green_mask": true
            }
        },
        "pre_delay": 500,
        "action": "Click",
        "post_delay": 7000,
        "next": [
            "PVP_Click:BeginCombat"
        ]
    },
    "PVP_Click:BeginCombat": {
        "desc": "点击作战开始（复用 UI/Combat/Start3 模板）。timeout: 30000ms 覆盖长加载场景（loading 画面持续动画，无法 post_wait_freezes）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "UI/Combat/Start3.png"
                ],
                "roi": [
                    950,
                    250,
                    330,
                    160
