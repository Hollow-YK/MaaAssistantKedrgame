                "ReturnGift_Day"
            ],
            "group": [
                "Daily",
                "Friend"
            ],
            "controller": [
                "ADB"
            ]
        }
    ],
    "option": {
        "ReturnGift_Day": {
            "label": "$option.ReturnGift_Day.label",
