                                "day": 4
                            }
                        }
                    }
                },
                {
                    "name": "FiveDaysAgo",
                    "label": "$option.ReturnGift_Day_5.label",
                    "pipeline_override": {
                        "ReturnGift_Do:ReturnGift": {
                            "attach": {
                                "day": 5
                            }
                        }
                    }
                },
                {
                    "name": "SixDaysAgo",
                    "label": "$option.ReturnGift_Day_6.label",
                    "pipeline_override": {
                        "ReturnGift_Do:ReturnGift": {
                            "attach": {
                                "day": 6
                            }
